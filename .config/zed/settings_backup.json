// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
	"show_whitespaces": "selection",
	"toolbar": {
		"code_actions": true
	},
	"gutter": {
		"min_line_number_digits": 3
	},
	"agent_ui_font_size": 13.0,
	"minimum_contrast_for_highlights": 50.0,
	"current_line_highlight": "all",
	"cursor_blink": true,
	"buffer_line_height": "standard",
	"languages": {
		"Python": {
			"language_servers": ["ty", "!basedpyright", "..."]
		},
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TSX": {
			"formatter": { "language_server": { "name": "biome" } },
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } },
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"JSONC": {
			"formatter": { "language_server": { "name": "biome" } },
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"CSS": {
			"formatter": { "language_server": { "name": "biome" } },
			"format_on_save": "on",
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		}
	},
	"lsp": {
		"biome": {
			"binary": {
				"path": "/opt/homebrew/bin/biome",
				"arguments": ["lsp-proxy"]
			}
		}
	},
	"agent_servers": {
		"OpenCode": {
			"command": "opencode",
			"args": ["acp"]
		}
	},
	"icon_theme": "Colored Zed Icons Theme Dark",
	"edit_predictions": {
		"mode": "subtle",
		"copilot": {
			"proxy": null,
			"proxy_no_verify": null
		},
		"enabled_in_text_threads": false
	},
	"terminal": {
		"dock": "bottom"
	},
	"features": {
		"edit_prediction_provider": "zed"
	},
	"agent": {
		"always_allow_tool_actions": true,
		"default_model": {
			"provider": "anthropic",
			"model": "claude-sonnet-4-latest"
		}
	},
	"base_keymap": "VSCode",
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"ui_font_size": 13.0,
	"ui_font_family": "Hack FC Ligatured",
	"buffer_font_size": 14,
	"buffer_font_family": "Hack FC Ligatured",
	"theme": {
		"mode": "dark",
		"light": "Catppuccin Mocha (Blur) [Light]",
		"dark": "Catppuccin Macchiato (Blur) [Heavy]"
	},
	"project_panel": {
		"auto_fold_dirs": false
	}
	// "experimental.theme_overrides": {
