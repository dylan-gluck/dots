// Zellij configuration
// Aesthetic: hyper-minimalist, transparent, Catppuccin Macchiato
// zjstatus replaces the built-in tab-bar and status-bar

// --- Global options ---

default_mode "normal"
default_shell "fish"
default_layout "default"

// zjstatus manages pane frames dynamically — keep this off globally
pane_frames false

// No tips, no release notes — clean start
show_startup_tips false
show_release_notes false

// Transparent-friendly: no rounded corners (they need solid bg to look right)
ui {
    pane_frames {
        rounded_corners true
        hide_session_name true
    }
}

// --- Theme: Catppuccin Macchiato (matching ghostty) ---
// Defined to match ghostty's Catppuccin Macchiato palette.
// Frame colors kept subtle so they work against a transparent terminal.

themes {
    catppuccin-macchiato {
        // Frames: dim overlay for unselected, green accent for selected
        frame_unselected {
            base 110 115 141    // #6e738d overlay0
            background 0 0 0
            emphasis_0 110 115 141
            emphasis_1 110 115 141
            emphasis_2 110 115 141
            emphasis_3 110 115 141
        }
        frame_selected {
            base 166 218 149   // #a6da95 green
            background 0 0 0
            emphasis_0 166 218 149
            emphasis_1 138 173 244
            emphasis_2 166 218 149
            emphasis_3 166 218 149
        }
        frame_highlight {
            base 138 173 244   // #8aadf4 blue — non-normal modes
            background 0 0 0
            emphasis_0 138 173 244
            emphasis_1 245 169 127
            emphasis_2 138 173 244
            emphasis_3 138 173 244
        }

        // Ribbons (tabs in built-in UI, mode indicators)
        ribbon_unselected {
            base 110 115 141
            background 0 0 0
            emphasis_0 110 115 141
            emphasis_1 202 211 245
            emphasis_2 110 115 141
            emphasis_3 110 115 141
        }
        ribbon_selected {
            base 166 218 149
            background 0 0 0
            emphasis_0 166 218 149
            emphasis_1 202 211 245
            emphasis_2 138 173 244
            emphasis_3 166 218 149
        }

        // Text
        text_unselected {
            base 165 173 203   // #a5adcb subtext0
            background 0 0 0
            emphasis_0 138 173 244
            emphasis_1 202 211 245
            emphasis_2 166 218 149
            emphasis_3 238 212 159
        }
        text_selected {
            base 202 211 245   // #cad3f5 text
            background 54 58 79 // #363a4f surface0
            emphasis_0 138 173 244
            emphasis_1 202 211 245
            emphasis_2 166 218 149
            emphasis_3 238 212 159
        }

        // Tables (session manager, plugin manager, etc.)
        table_title {
            base 202 211 245
            background 0 0 0
            emphasis_0 138 173 244
            emphasis_1 166 218 149
            emphasis_2 238 212 159
            emphasis_3 245 169 127
        }
        table_cell_unselected {
            base 165 173 203
            background 0 0 0
            emphasis_0 138 173 244
            emphasis_1 202 211 245
            emphasis_2 166 218 149
            emphasis_3 238 212 159
        }
        table_cell_selected {
            base 202 211 245
            background 54 58 79
            emphasis_0 138 173 244
            emphasis_1 202 211 245
            emphasis_2 166 218 149
            emphasis_3 238 212 159
        }

        // Lists
        list_unselected {
            base 165 173 203
            background 0 0 0
            emphasis_0 138 173 244
            emphasis_1 202 211 245
            emphasis_2 166 218 149
            emphasis_3 238 212 159
        }
        list_selected {
            base 202 211 245
            background 54 58 79
            emphasis_0 138 173 244
            emphasis_1 202 211 245
            emphasis_2 166 218 149
            emphasis_3 238 212 159
        }

        // Exit codes
        exit_code_success {
            base 166 218 149
            background 0 0 0
            emphasis_0 166 218 149
            emphasis_1 166 218 149
            emphasis_2 166 218 149
            emphasis_3 166 218 149
        }
        exit_code_error {
            base 237 135 150   // #ed8796 red
            background 0 0 0
            emphasis_0 237 135 150
            emphasis_1 237 135 150
            emphasis_2 237 135 150
            emphasis_3 237 135 150
        }

        // Multiplayer
        multiplayer_user_colors {
            player_1 138 173 244  // blue
            player_2 166 218 149  // green
            player_3 238 212 159  // yellow
            player_4 245 169 127  // peach
            player_5 198 160 246  // mauve
            player_6 237 135 150  // red
            player_7 245 189 230  // pink
            player_8 125 196 228  // sapphire
            player_9 141 213 202  // teal
            player_10 145 215 227 // sky
        }
    }
}

theme "catppuccin-macchiato"

// --- Plugin aliases ---

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    zellij:link
}
